{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "_meta": {
    "ashen-crown/category": "inspect",
    "ashen-crown/risk": "low"
  },
  "annotations": {
    "destructiveHint": false,
    "idempotentHint": true,
    "openWorldHint": false,
    "readOnlyHint": true
  },
  "description": "读取当前 Run 的精简世界事实。默认只返回玩家已知信息；visibility=gm 可读取隐藏 Flag、NPC 真实位置与所有区域状态。先读后写。",
  "inputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "properties": {
      "runId": {
        "description": "正在操作的游戏 Run ID。MCP 无隐式会话，因此每次调用都必须显式携带。",
        "minLength": 1,
        "type": "string",
        "x-mcp-header": "Run-Id"
      },
      "visibility": {
        "default": "player",
        "enum": [
          "player",
          "gm"
        ],
        "type": "string"
      }
    },
    "required": [
      "runId"
    ],
    "type": "object"
  },
  "name": "inspect_world",
  "outputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "properties": {
      "auditId": {
        "type": "string"
      },
      "changed": {
        "type": "boolean"
      },
      "data": {},
      "dryRun": {
        "type": "boolean"
      },
      "risk": {
        "type": "string"
      },
      "runId": {
        "type": "string"
      },
      "summary": {
        "type": "string"
      },
      "tool": {
        "type": "string"
      },
      "warnings": {
        "items": {
          "type": "string"
        },
        "type": "array"
      }
    },
    "required": [
      "tool",
      "runId",
      "changed",
      "summary"
    ],
    "type": "object"
  },
  "title": "Inspect World"
}

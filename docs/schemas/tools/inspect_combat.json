{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "_meta": {
    "ashen-crown/category": "inspect",
    "ashen-crown/risk": "low"
  },
  "annotations": {
    "destructiveHint": false,
    "idempotentHint": true,
    "openWorldHint": false,
    "readOnlyHint": true
  },
  "description": "读取当前战斗事实：敌人、意图、距离、地形危险、玩家状态和可用职业技能。",
  "inputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "properties": {
      "runId": {
        "description": "正在操作的游戏 Run ID。MCP 无隐式会话，因此每次调用都必须显式携带。",
        "minLength": 1,
        "type": "string",
        "x-mcp-header": "Run-Id"
      }
    },
    "required": [
      "runId"
    ],
    "type": "object"
  },
  "name": "inspect_combat",
  "outputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "properties": {
      "auditId": {
        "type": "string"
      },
      "changed": {
        "type": "boolean"
      },
      "data": {},
      "dryRun": {
        "type": "boolean"
      },
      "risk": {
        "type": "string"
      },
      "runId": {
        "type": "string"
      },
      "summary": {
        "type": "string"
      },
      "tool": {
        "type": "string"
      },
      "warnings": {
        "items": {
          "type": "string"
        },
        "type": "array"
      }
    },
    "required": [
      "tool",
      "runId",
      "changed",
      "summary"
    ],
    "type": "object"
  },
  "title": "Inspect Combat"
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "_meta": {
    "ashen-crown/category": "map_mutation",
    "ashen-crown/risk": "medium"
  },
  "annotations": {
    "destructiveHint": false,
    "idempotentHint": false,
    "openWorldHint": false,
    "readOnlyHint": false
  },
  "description": "连接两个已存在的地图节点。不会自动解锁或发现房间。",
  "inputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "properties": {
      "dryRun": {
        "default": false,
        "description": "仅在副本上执行并返回预览，不写入真实 Run。高影响操作应先 dryRun。",
        "type": "boolean"
      },
      "from": {
        "minLength": 1,
        "type": "string"
      },
      "reason": {
        "description": "简短说明这次世界修改的剧情/规则原因，便于审计。",
        "maxLength": 200,
        "type": "string"
      },
      "runId": {
        "description": "正在操作的游戏 Run ID。MCP 无隐式会话，因此每次调用都必须显式携带。",
        "minLength": 1,
        "type": "string",
        "x-mcp-header": "Run-Id"
      },
      "to": {
        "minLength": 1,
        "type": "string"
      }
    },
    "required": [
      "runId",
      "from",
      "to"
    ],
    "type": "object"
  },
  "name": "connect_rooms",
  "outputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "properties": {
      "auditId": {
        "type": "string"
      },
      "changed": {
        "type": "boolean"
      },
      "data": {},
      "dryRun": {
        "type": "boolean"
      },
      "risk": {
        "type": "string"
      },
      "runId": {
        "type": "string"
      },
      "summary": {
        "type": "string"
      },
      "tool": {
        "type": "string"
      },
      "warnings": {
        "items": {
          "type": "string"
        },
        "type": "array"
      }
    },
    "required": [
      "tool",
      "runId",
      "changed",
      "summary"
    ],
    "type": "object"
  },
  "title": "Connect Rooms"
}

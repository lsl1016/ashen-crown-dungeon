{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Ashen Crown AI GM Tool Catalog",
  "tools": [
    {
      "name": "advance_bell",
      "title": "Advance World Bell",
      "description": "推进世界钟声 1-3 次，会驱动 NPC 日程、商店刷新和世界事件。高影响，默认先 dryRun。",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "properties": {
          "dryRun": {
            "default": false,
            "description": "仅在副本上执行并返回预览，不写入真实 Run。高影响操作应先 dryRun。",
            "type": "boolean"
          },
          "reason": {
            "description": "简短说明这次世界修改的剧情/规则原因，便于审计。",
            "maxLength": 200,
            "type": "string"
          },
          "runId": {
            "description": "正在操作的游戏 Run ID。MCP 无隐式会话，因此每次调用都必须显式携带。",
            "minLength": 1,
            "type": "string",
            "x-mcp-header": "Run-Id"
          },
          "steps": {
            "default": 1,
            "maximum": 3,
            "minimum": 1,
            "type": "integer"
          }
        },
        "required": [
          "runId"
        ],
        "type": "object"
      },
      "outputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "properties": {
          "auditId": {
            "type": "string"
          },
          "changed": {
            "type": "boolean"
          },
          "data": {},
          "dryRun": {
            "type": "boolean"
          },
          "risk": {
            "type": "string"
          },
          "runId": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "tool": {
            "type": "string"
          },
          "warnings": {
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        },
        "required": [
          "tool",
          "runId",
          "changed",
          "summary"
        ],
        "type": "object"
      },
      "annotations": {
        "destructiveHint": true,
        "idempotentHint": false,
        "openWorldHint": false,
        "readOnlyHint": false
      },
      "_meta": {
        "ashen-crown/category": "world_mutation",
        "ashen-crown/risk": "high"
      }
    },
    {
      "name": "connect_rooms",
      "title": "Connect Rooms",
      "description": "连接两个已存在的地图节点。不会自动解锁或发现房间。",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "properties": {
          "dryRun": {
            "default": false,
            "description": "仅在副本上执行并返回预览，不写入真实 Run。高影响操作应先 dryRun。",
            "type": "boolean"
          },
          "from": {
            "minLength": 1,
            "type": "string"
          },
          "reason": {
            "description": "简短说明这次世界修改的剧情/规则原因，便于审计。",
            "maxLength": 200,
            "type": "string"
          },
          "runId": {
            "description": "正在操作的游戏 Run ID。MCP 无隐式会话，因此每次调用都必须显式携带。",
            "minLength": 1,
            "type": "string",
            "x-mcp-header": "Run-Id"
          },
          "to": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "runId",
          "from",
          "to"
        ],
        "type": "object"
      },
      "outputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "properties": {
          "auditId": {
            "type": "string"
          },
          "changed": {
            "type": "boolean"
          },
          "data": {},
          "dryRun": {
            "type": "boolean"
          },
          "risk": {
            "type": "string"
          },
          "runId": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "tool": {
            "type": "string"
          },
          "warnings": {
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        },
        "required": [
          "tool",
          "runId",
          "changed",
          "summary"
        ],
        "type": "object"
      },
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": false,
        "openWorldHint": false,
        "readOnlyHint": false
      },
      "_meta": {
        "ashen-crown/category": "map_mutation",
        "ashen-crown/risk": "medium"
      }
    },
    {
      "name": "create_room",
      "title": "Create Room",
      "description": "创建一个新地图节点，可选立即连接到现有房间。只创建数据，不允许执行代码或自定义脚本。",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "properties": {
          "connectTo": {
            "type": "string"
          },
          "description": {
            "maxLength": 500,
            "type": "string"
          },
          "discovered": {
            "default": false,
            "type": "boolean"
          },
          "dryRun": {
            "default": false,
            "description": "仅在副本上执行并返回预览，不写入真实 Run。高影响操作应先 dryRun。",
            "type": "boolean"
          },
          "id": {
            "pattern": "^[a-zA-Z0-9_.-]{1,64}$",
            "type": "string"
          },
          "name": {
            "maxLength": 80,
            "minLength": 1,
            "type": "string"
          },
          "reason": {
            "description": "简短说明这次世界修改的剧情/规则原因，便于审计。",
            "maxLength": 200,
            "type": "string"
          },
          "runId": {
            "description": "正在操作的游戏 Run ID。MCP 无隐式会话，因此每次调用都必须显式携带。",
            "minLength": 1,
            "type": "string",
            "x-mcp-header": "Run-Id"
          },
          "type": {
            "maxLength": 40,
            "minLength": 1,
            "type": "string"
          },
          "x": {
            "maximum": 100,
            "minimum": -100,
            "type": "integer"
          },
          "y": {
            "maximum": 100,
            "minimum": -100,
            "type": "integer"
          },
          "zone": {
            "maxLength": 60,
            "type": "string"
          }
        },
        "required": [
          "runId",
          "id",
          "name",
          "type",
          "x",
          "y"
        ],
        "type": "object"
      },
      "outputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "properties": {
          "auditId": {
            "type": "string"
          },
          "changed": {
            "type": "boolean"
          },
          "data": {},
          "dryRun": {
            "type": "boolean"
          },
          "risk": {
            "type": "string"
          },
          "runId": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "tool": {
            "type": "string"
          },
          "warnings": {
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        },
        "required": [
          "tool",
          "runId",
          "changed",
          "summary"
        ],
        "type": "object"
      },
      "annotations": {
        "destructiveHint": true,
        "idempotentHint": false,
        "openWorldHint": false,
        "readOnlyHint": false
      },
      "_meta": {
        "ashen-crown/category": "map_mutation",
        "ashen-crown/risk": "high"
      }
    },
